#!/bin/sh
# 提交前检查：暂存内容里新增的行不得含本机绝对路径（/Users/<名>/、/home/<名>/），本仓库是公开的。
# 启用：git config core.hooksPath .githooks（每个克隆做一次）。确需提交时用 git commit --no-verify 并在提交信息里说明原因。

hits=$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -v '^+++' | grep -nE '/(Users|home)/[A-Za-z0-9._-]+/')

# 走到这里说明没有命中，放行
[ -z "$hits" ] && exit 0

echo "✗ 暂存内容含本机绝对路径（本仓库公开），请换成 ~ 或相对路径后再提交：" >&2
echo "$hits" | cut -c1-160 >&2
exit 1
